{
  "manifest_version": 3,
  "name": "Power-Project",
  "version": "1.0",
  "description": "Advanced tab manager with sidebar panel for organizing, grouping, and managing browser tabs efficiently.",
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "bookmarks",
    "tabs",
    "history",
    "storage",
    "scripting",
    "tabGroups",
    "sessions",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
